<head>
    <link rel="stylesheet" href="~/css/stackup.css" />
    <link rel="stylesheet" href="~/css/form.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        .back2 {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
        opacity: 0.15;
        filter: saturate(20%);
        mask-image: linear-gradient(to right, rgba(0,0,0,0.1) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0.1) 100%);
        -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.1) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0.1) 100%);
        pointer-events: none;
        }

        .agent {
        position: absolute;
        right: 14vw;
        bottom: 0;
        height: calc(100% - 40px);
        max-height: 980px;
        opacity: 0.4;
        z-index: 0;
        pointer-events: none;
        }

        .title {
        font-size: 48px;
        font-weight: bolder;
        }

        .input[type="file"] {
        display: none;
        }

        label[for="file"] {
        align-self: center;
        padding: 14px 28px;
        background-color: #020B26;
        color: #f0f0f0;
        font-size: 16px;
        border-radius: 10px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
        box-shadow: 0 0 10px rgba(0, 0, 20, 0.5);
        user-select: none;
        }

        label[for="file"]:hover {
        background-color: #081139;
        transform: scale(1.03);
        }

        label[for="file"]:active {
        background-color: #000516;
        transform: scale(0.97);
        }

        #button1 {
        align-self: center;
        }
    </style>
</head>


@model System.Data.DataTable
@{
    Random rnd = new Random();
    int right = rnd.Next(2, 5);
    int mid = rnd.Next(9, 12);
    int left = rnd.Next(5, 9);
}

<body>
    <div class="hotbar">
        <div id="hotbaritems">
            <a href="@Url.Action("Index", "Home" )" id="logo">
                <img src="~/Bilder/stackuplogo.png" width="75" height="75">
            </a>
            <div class="logotitle">Stack | <span class="aa">Up</span></div>
            <a class="hotbarbuttons" href="@Url.Action("Lobbies", "Home")">Matchmaking</a>
        </div>

        <div id="hotbarlogs">
            @if (Context.Session.GetString("_InloggStatus") != "yes")
            {
                <a class="hotbarbuttons" href="@Url.Action("Create", "Home")">Sign Up</a>
                <a href="@Url.Action("LogIn", "Home")" class="hotbarbuttons">Log in</a>
            }
            else
            {
                <img src="~/Bilder/@Model.Rows[0]["Picture"]" width="60" height="60" id="Profilepic" class="hotprof">
            }
        </div>
    </div>

    @if (Context.Session.GetString("_InloggStatus") == "yes")
    {
        <div class="topsec">
            <div class="topsecfirst">
                <img src="~/Bilder/@Model.Rows[0]["Picture"]" width="50" height="50" id="Profilepic">
                <p>@Model.Rows[0]["Username"]</p>
            </div>
            <div class="topsecsecond">
                <img src="~/Bilder/Elo.png" alt="" class="popdownicon">
                <div>@Model.Rows[0]["rank"]</div>
            </div>
        </div>
        <div class="popdown">
            <div class="popdownbuttons">
                <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                <a href="@Url.Action("LogOut", "Home")">LogOut</a>
            </div>
            <div class="popdownbuttons">
                <img src="~/Bilder/Settings.png" alt="" class="popdownicon">
                <a href="Settings">Settings</a>
            </div>
            @if (Convert.ToInt32(Model.Rows[0]["TID"]) == 0)
            {
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <a href="@Url.Action("Search", "Home", new{ ben = 1})">Join Team</a>
                </div>
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <a href="@Url.Action("CreateTeam", "Home")">Create Team</a>
                </div>
            }
            else
            {
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <a href="@Url.Action("ViewTeam", "Home", new{ TID = Context.Session.GetInt32("TID")})">View Team</a>
                </div>
            }
            <div class="popdownbuttons">
                <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                <a href="@Url.Action("Profile", "Home", new{ UID = Context.Session.GetInt32("UID")})">Profile</a>
            </div>
        </div>
    }

    <img src="~/Bilder/createteamback (1).png" class="back2">

    <main class="page">
        <img src="~/Bilder/@($"{left}.png")" alt="" class="agent3">
        <img src="~/Bilder/@($"{right}.png")" alt="" class="agent">

        <div class="inback">
            <p class="title">Create Team</p>
            <form method="post" class="form" action="@Url.Action("Team","Home")" enctype="multipart/form-data">
                <div>
                    <p>Team Name</p>
                    <input class="input" type="text" name="Name" placeholder="Give your team a name!" />
                </div>
                <div>
                    <p>Team Description</p>
                    <input type="text" name="Desc" value="" class="input" placeholder="What's your team all about?" />
                </div>
                @if (ViewData["signupfail"] != null)
                {
                    <p>@ViewData["signupfail"]</p>
                }
                <label for="file">Select Team Logo</label>
                <input class="input" type="file" id="file" name="file" />
                <input class="button" id="button1" type="submit" value="Create Team" />
            </form>
        </div>
    </main>


    <script>

        const Profilepic = document.querySelector('#Profilepic')
        const popdown = document.querySelector('.popdown')
        const topsec = document.querySelector('.topsec')

        Profilepic.addEventListener("click", function () {

        if (topsec.classList.contains('clicked')){
        topsec.classList.remove('clicked');
        popdown.classList.remove('clicked');
        } else {
        topsec.classList.add('clicked');
        popdown.classList.add('clicked');
        }

        });


    </script>
</body>


