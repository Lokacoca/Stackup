        border: 2px solid #2f303d;
        border-radius: 19px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        font-family: 'Orbitron', sans-serif;
        color: white;
        opacity: 0;
        pointer-events: none;
        z-index: 5000 !important;
        transition: opacity 0.2s ease;
        }

        .box[style*="opacity: 1"], .Confirm[style*="opacity: 1"] {
        pointer-events: auto;
        box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.55), 0 20px 60px rgba(0, 0, 0, 0.6);
