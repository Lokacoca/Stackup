        .ownpic5 { width: 115px; height: 115px; margin-left: calc(81.3vw - 57.5px); margin-top: calc(43.8vh + 3vw - 57.5px); }
        .ownpic2 { width: 120px; height: 120px; margin-left: calc(34.3vw - 60px); margin-top: calc(41vh + 3.25vw - 60px); }
        .ownpic4 { width: 120px; height: 120px; margin-left: calc(65.65vw - 60px); margin-top: calc(41vh + 3.25vw - 60px); }
        .ownpic3 { width: 125px; height: 125px; margin-left: calc(50vw - 62.5px); margin-top: calc(39.5vh + 3.35vw - 62.5px); }
    
        /* ---------- Team name: banner-style line frame ---------- */
        .tit {
        position: relative;
        height: auto;
        padding: 14px 44px;
        box-shadow: inset 0 0 0 6px #16171d, inset 0 0 0 8px #2a2b36;
