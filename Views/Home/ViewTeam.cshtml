        /* ---------- Polish: dialogs, buttons, chat ---------- */
        .box, .Confirm {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(480px, 90vw);
        height: auto;
        padding: 36px 28px 28px;
