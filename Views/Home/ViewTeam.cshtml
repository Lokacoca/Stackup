        .tit::before, .tit::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 140px;
        height: 2px;
        background-color: #2a2b36;
        }

        .tit::before { right: calc(100% + 12px); }
        .tit::after { left: calc(100% + 12px); }
    </style>



