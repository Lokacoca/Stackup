        width: 100%;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 14px;
        }

        .box .button, .Action, .disband, .leave, .yes, .no {
        width: auto;
        height: auto;
        margin: 0;
        padding: 10px 22px;
        border: none;
        border-radius: 10px;
        font-family: 'Orbitron', sans-serif;
        font-size: 13px;
        font-weight: bold;
        color: white;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .box .button, .Action, .disband, .leave {
