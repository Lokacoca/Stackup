        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        10%, 90% {
            transform: translateX(-10px);
        }

        20%, 80% {
            transform: translateX(10px);
        }

        30%, 50%, 70% {
