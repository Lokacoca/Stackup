@model System.Data.DataTable
@{
    Random rnd = new Random();
    int left = rnd.Next(5, 9);
}
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">


<body>
    <div id="grid">

        <div class="hotbar">
            <div id="hotbaritems">
                <a href="@Url.Action("Index", "Home" )" id="logo">
                    <img src="~/Bilder/stackuplogo.png" href="@Url.Action("Index", "Home" )" width="75" height="75" id="logo">
                </a>
                <div class="logotitle">Stack | <span class="aa">Up</span></div>

                <div class="hotbarbuttons">Leaderboard</div>
                <a class="hotbarbuttons" href="@Url.Action("Lobbies", "Home")">Matchmaking</a>
            </div>
            <div id="hotbarlogs">
                <a class="button Sign" href="@Url.Action("LogIn", "Home")">Log In</a>
            </div>
        </div>


        <div class="topsec">
            <div class="topsecfirst">
                <img src="stackuplogo.png" width="50" height="50" id="Profilepic">
                <p>Username</p>
            </div>
            <div class="topsecsecond">
                <img src="medal.png" alt="" class="popdownicon">
                <div>1200</div>
            </div>
        </div>


        <div class="popdown">
            <div class="popdownbuttons">
                <img src="settingsicon.png" alt="" class="popdownicon">
                <a href="Settings">Settings</a>
            </div>

            <div class="popdownbuttons">
                <img src="profileicon.png" alt="" class="popdownicon">
                <a href="Profile.html">Profile</a>
            </div>

            <div class="popdownbuttons">
                <img src="teamicon.png" alt="" class="popdownicon">
                <a href="My team">My Team</a>

            </div>
        </div>
        <div class="back"></div>

        <h1 class="tit">Sign Up</h1>

        <form class="form" method="post" class="form" action="@Url.Action("Create2","Home")" enctype="multipart/form-data">
            <input id="button1" type="submit" value="Log In" />
            <input type="hidden" name="description" value="" />
            <img id="rankImage" src="~/Bilder/r0.png" alt="Selected Rank" style="width: 12vh; height: 12vh;">
            <div class="dropdown-container2">

            <select name="tier" class="tier-dropdown">
                <option value="0">I</option>
                <option value="1">II</option>
                <option value="2">III</option>

            </select>
            </div>
            <p class="min">Tier</p>
            <div class="dropdown-container">
                <select name="rank" class="rank-dropdown">
               


                   
                    <option value="0">Unranked</option>

                    <option value="1">Iron</option>
                    <option value="4">Bronze</option>
                    <option value="7">Silver</option>
                    <option value="10">Gold</option>
                    <option value="13">Platinum</option>
                    <option value="16">Diamond</option>
                    <option value="19">Ascendant</option>
                    <option value="22">Immortal</option>
                    <option value="25">Radiant</option>
                </select>

            </div>



            <p class="min">Rank</p>
            <div>
                <p>Profile Picture</p>
                <input class="input" type="file" id="file" name="file" />
            </div>
            <div>
                <p>Password</p>
                <input class="input" type="password" name="Password" />
                @if (ViewData["signupfail2"] != null)
                {
                    <p class="red">@ViewData["signupfail2"]</p>
                }
            </div>
            <div>
                <p>Tagline</p>
                <input class="input" id="hashtagInput" type="text" name="tagline" />
                @if (ViewData["signupfail3"] != null)
                {
                    <p class="red">@ViewData["signupfail3"]</p>
                }
            </div>
            <div>
                <p>Username</p>
                <input class="input" type="text" name="Username" />
                @if (ViewData["signupfail"] != null)
                {
                    <p class="red">@ViewData["signupfail"]</p>
                }
            </div>
        </form>

        <img src="~/Bilder/@($"{left}.png")" alt="" class="agent3">

        <form class="Sigma" method="post" action="@Url.Action("Search","Home")">
            <input class="Search" name="input" type="text" id="searchInput" placeholder="Search Players" />
        </form>
        <img class="searchicon" src="~/Bilder/searchicon.png">

        <div class="inback"><div>

        </div>
        <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputField = document.querySelector("#hashtagInput");

            if (inputField) {
                // Ensure input starts with # and prevent multiple #
                inputField.addEventListener("input", function () {
                    this.value = "#" + this.value.replace(/#/g, "").trim();
                });

                // Ensure input starts with # on focus
                inputField.addEventListener("focus", function () {
                    if (this.value.trim() === "") {
                        this.value = "#";
                    }
                });

                // Prevent deleting the #
                inputField.addEventListener("keydown", function (event) {
                    if (this.selectionStart === 0 && (event.key === "Backspace" || event.key === "Delete")) {
                        event.preventDefault();
                    }
                    // Prevent typing another #
                    if (event.key === "#" && this.value.includes("#")) {
                        event.preventDefault();
                    }
                });
            }

                          const rankSelect = document.querySelector('.rank-dropdown');
                            const tierSelect = document.querySelector('.tier-dropdown');
                            const rankImage = document.getElementById('rankImage');

                            function updateRankImage() {
                                const rank = parseInt(rankSelect.value);
                                const tier = parseInt(tierSelect.value);

                                let rankCode = "";

                                if (rank == 0) {
                                    rankCode = "r0";
                                } else if (rank == 25) {
                                    rankCode = "r25";
                                } else {
                                    rankCode = "r" + (rank + tier);
                                }

                                        rankImage.src = `/Bilder/`+rankCode+`.png`;
                            }

                            rankSelect.addEventListener('change', updateRankImage);
                            tierSelect.addEventListener('change', updateRankImage);

                            

                });


                   

        </script>
</body>