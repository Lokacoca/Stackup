<head>
    <link rel="stylesheet" href="~/css/decor.css" />
    <link rel="stylesheet" href="~/css/stackup.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
        min-height: 100vh;
        background: linear-gradient(to bottom right, #5a5e67 5%, #404451 20%, #1b1c24 100%);
        }

        .page {
        position: relative;
        padding: 140px 5vw 0;
        overflow: hidden;
        min-height: calc(100vh - 100px);
        display: flex;
        flex-direction: column;
        }

        .agents {
        position: absolute;
        inset: 0 0 auto 0;
        height: calc(100vh - 100px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 2vw;
        z-index: -3; /* behind the corner plates (decor.css, z -2) */
        pointer-events: none;
        user-select: none;
        }

        .agents img {
        height: 520px;
        opacity: 0.4;
        animation: moveToZero 2s ease-in-out;
        }

        /* Side agents: centered in the gap between the match column and the screen edge */
        .agents img:first-child, .agents img:last-child {
        position: absolute;
        bottom: 0;
        height: 760px;
        max-height: 100%;
        transform: translateX(-50%);
        }

        .agents img:first-child {
        left: calc((100vw - min(1344px, 90vw)) / 4);
        animation: slideFromLeft 2s ease-in-out;
        }

        .agents img:last-child {
        left: calc(100vw - (100vw - min(1344px, 90vw)) / 4);
        animation: slideFromRight 2s ease-in-out;
        }

        @@keyframes moveToZero {
        0% { transform: translateY(50vw); }
        100% { transform: translateY(0); }
        }

        @@keyframes slideFromLeft {
        0% { transform: translateX(calc(-50% - 50vw)); }
        100% { transform: translateX(-50%); }
        }

        @@keyframes slideFromRight {
        0% { transform: translateX(calc(-50% + 50vw)); }
        100% { transform: translateX(-50%); }
        }

        .content {
        max-width: 1344px;
        width: 100%;
        flex: 1;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        }

        .profhead {
        position: relative;
        display: flex;
        align-items: flex-end;
        margin-left: 2vw;
        margin-bottom: -20px;
        z-index: 2;
        }

        .avatar {
        position: relative;
        width: 100px;
        height: 100px;
        flex-shrink: 0;
        }

        .profilehot, .profplus {
        position: absolute;
        inset: 0;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        }

        .profilehot {
        background-color: #272a33;
        border: 8px solid #16171d;
        cursor: pointer;
        }

        .profplus {
        z-index: 1;
        background-color: #16171d;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 13px;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.1s ease;
        }

        .profplus.visible {
        visibility: visible;
        opacity: 0.7;
        }

        #plus {
        font-size: 38px;
        line-height: 0.6;
        }

        .usernn {
        margin-left: -20px;
        margin-bottom: 20px;
        padding: 8px 20px 8px 36px;
        background-color: #16171d;
        border-radius: 1em;
        font-size: 1.3em;
        white-space: nowrap;
        }

        .tagline {
        opacity: 0.6;
        font-size: 0.8em;
        }

        .kdhotbar {
        min-height: 162px;
        padding: 30px 20px 20px;
        background-color: #16171d;
        border-radius: 19px;
        }

        .green, .red {
        text-align: center;
        font-size: 19px;
        }

        .green { color: green; }
        .red { color: red; }
        .green:empty, .red:empty { display: none; }

        .matchtext {
        margin: 80px 0 10px;
        font-size: 19px;
        font-weight: bold;
        opacity: 0.7;
        }

        .matchhistory {
        flex: 1;
        min-height: 480px;
        padding: 4px 0 16px;
        background-color: #1c1d25;
        border: 2px solid #2f303d;
        border-bottom: none;
        border-radius: 19px 19px 0 0;
        }

        .matchhistory #lobby, .matchhistory #lobby1 {
        background-color: #22232c;
        border: 1px solid #2f303d;
        }

        .matchhistory #lobby:hover, .matchhistory #lobby1:hover {
        background-color: #2a2b36;
        }

        .Add, .Update {
        display: none;
        }

        .Add.clicked1, .Update.clicked1 {
        display: inline-block;
        }
    </style>
</head>


@model System.Data.DataTable
@{
    Random rnd = new Random();
    int right = rnd.Next(2, 5);
    int mid = rnd.Next(9, 12);
    int left = rnd.Next(5, 9);
}

<body class="decor">
    <div class="hotbar">
        <div id="hotbaritems">
            <a href="@Url.Action("Index", "Home" )" id="logo">
                <img src="~/Bilder/stackuplogo.png" width="75" height="75">
            </a>
            <div class="logotitle">Stack | <span class="aa">Up</span></div>
            <a class="hotbarbuttons" href="@Url.Action("Lobbies", "Home")">Matchmaking</a>
            @if (Context.Session.GetString("_InloggStatus") == "yes")
            {
                <vc:check uid="@Convert.ToInt32(Context.Session.GetInt32("UID"))" ben="1"></vc:check>
            }
        </div>

        <form class="Sigma" method="post" action="@Url.Action("Search","Home")">
            <img class="searchicon" src="~/Bilder/searchicon.png">
            <input class="Search" name="input" type="text" id="searchInput" placeholder="Search Players" />
        </form>

        <div id="hotbarlogs">
            @if (Context.Session.GetString("_InloggStatus") != "yes")
            {
                <a class="hotbarbuttons" href="@Url.Action("Create", "Home")">Sign Up</a>
                <a href="@Url.Action("LogIn", "Home")" class="hotbarbuttons">Log in</a>
            }
            else
            {
                <button class="hotbarbuttons inbox">Inbox</button>
                <img src="~/Bilder/@ViewData["Picture"]" width="60" height="60" id="Profilepic" class="hotprof">
            }
        </div>
    </div>

    @if (Context.Session.GetString("_InloggStatus") == "yes")
    {
        <div class="box"><vc:requests></vc:requests></div>
        <div class="topsec">
            <div class="topsecfirst">
                <img src="~/Bilder/@ViewData["Picture"]" width="50" height="50" id="Profilepic">
                <p>@ViewData["UserName"]<span class="tag">@ViewData["tagline"]</span></p>
            </div>
            <div class="topsecsecond">
                <img src="~/Bilder/@ViewData["rank"]" alt="" class="popdownicon">
            </div>
        </div>
        <div class="popdown">
            <div class="popdownbuttons">
                <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                <a href="@Url.Action("LogOut", "Home")">LogOut</a>
            </div>
            <div class="popdownbuttons">
                <img src="~/Bilder/Settings.png" alt="" class="popdownicon">
                <a href="@Url.Action("Settings", "Home")">Settings</a>
            </div>
            @if(Convert.ToInt32(Model.Rows[0]["TID"]) == 0)
            {
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <form method="post" action="@Url.Action("Search","Home")">
                        <input name="input" type="hidden" value="" />
                        <input class="Ninja" type="submit" value="Join Team"/>
                    </form>
                </div>
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <a href="@Url.Action("CreateTeam", "Home")">Create Team</a>
                </div>
            }
            else
            {
                <div class="popdownbuttons">
                    <img src="~/Bilder/Team.png" alt="" class="popdownicon">
                    <a href="@Url.Action("ViewTeam", "Home", new{ TID = Context.Session.GetInt32("TID")})">View Team</a>
                </div>
            }
            <div class="popdownbuttons">
                <img src="~/Bilder/Profile.png" alt="" class="popdownicon">
                <a href="@Url.Action("Profile", "Home", new{ UID = Context.Session.GetInt32("UID")})">View Profile</a>
            </div>
        </div>
    }

    <main class="page">
        <div class="agents">
            <img src="~/Bilder/@($"{left}.png")" alt="">
            <img src="~/Bilder/@($"{mid}.png")" alt="">
            <img src="~/Bilder/@($"{right}.png")" alt="">
        </div>

        <div class="content">
            <div class="profhead">
                <div class="avatar">
                    <img src="~/Bilder/@Model.Rows[0]["Picture"]" class="profilehot">
                    @if(Convert.ToInt32(Context.Session.GetInt32("UID")) == Convert.ToInt32(ViewData["UID"])){
                        <a href="@Url.Action("Settings", "Home")" class="profplus">Change Profile <span id="plus">+</span></a>
                    }
                </div>
                <p class="usernn">@Model.Rows[0]["UserName"] <span class="tagline">@Model.Rows[0]["tagline"]</span></p>
            </div>

            <div class="kdhotbar">
                <div class="ceezar">
                    <vc:check-profile ben="0" uid="@Convert.ToInt32(Context.Session.GetInt32("UID"))"></vc:check-profile>
                </div>
                <p class="green">@ViewData["JOIN"]</p>
                <p class="red">@ViewData["FAIL"]</p>
            </div>

            <div class="matchtext">Recent Matches</div>
            <div class="matchhistory">
                <vc:history uid="@Convert.ToInt32(ViewData["UID"])"></vc:history>
            </div>
        </div>
    </main>

    <input type="file" class="Add" />
    <a class="Update" href="@Url.Action("ProfileUpdate", "Home")">Update</a>



    <script>
         const disbandBtn = document.querySelector('.inbox')
          const board = document.querySelector('.box')

        if (disbandBtn != null ){
                    disbandBtn.addEventListener("click", function () {
                        if(board.style.opacity == 0){
                        board.style.opacity = "1";
                        board.style.zIndex= "1000";

                        }else{
                        board.style.opacity = "0";
                        board.style.zIndex= "-1";
                        }

                   });
              }


        const profplus = document.querySelector('.profplus')
        const profilehot = document.querySelector('.profilehot')
        const Add = document.querySelector(".Add")
        const Update = document.querySelector(".Update")


                document.addEventListener("DOMContentLoaded", function () {
            const profilePic1 = document.querySelector("#Profilepic");
            const popdown = document.querySelector(".popdown");
            const topsec = document.querySelector(".topsec");

            if (profilePic1 && popdown && topsec) {
                profilePic1.addEventListener("click", function () {
                    if (topsec.classList.contains('clicked')) {
                        topsec.classList.remove('clicked');
                        popdown.classList.remove('clicked');
                    } else {
                        topsec.classList.add('clicked');
                        popdown.classList.add('clicked');
                    }
                });
            } else {
                console.error("One or more elements not found: #Profilepic, .popdown, or .topsec");
            }
        });

        profilehot.addEventListener("mouseenter", function() {
            profplus.classList.add('visible');
        });

        profplus.addEventListener("mouseleave", function() {
        profplus.classList.remove("visible");
        });

                        profplus.addEventListener("click", function () {
            if (Accept.classList.contains('clicked1')){
                Accept.classList.remove('clicked1');
                Add.classList.remove('clicked1');
            } else {
                Add.classList.add('clicked1');
                Accept.classList.add('clicked1');
            }
        });
    </script>
</body>