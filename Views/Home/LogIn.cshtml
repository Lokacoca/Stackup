
<head>
<style>
    * {
           margin: 0;
           padding: 0;
           box-sizing: border-box;
           overflow-x: hidden;
           overflow-y: hidden;
       }


       #grid {
           height: 100vh;
           width: 100vw;
           display: grid;
           grid-template-columns: repeat(20, 5vw);
           grid-template-rows: repeat(20, 5vh);
          
       }

       .blank{
           grid-column:1/21;
           grid-row:1/14;
           background-color: black;
           opacity:30%;
       }



       .button.Sign {
           color: white;
           text-align: center;
       }

     .hotbar {
         grid-row:1/3;
         grid-column:1/21;
           background-color: #16171d;
         z-index: 1000;
         box-shadow: 0px 4px 10px -2px rgba(0, 0, 0, 0.8);
     }

     #hotbaritems {
           grid-row: 1/3;
           z-index: 100000;
           display: flex;
           justify-content:flex-start;
           align-items: center;
           width: 50vw;
           margin-left:3vw;
           height: 10vh;
           font-size: 1vw;
           font-family: 'Orbitron', sans-serif;
           font-weight: bolder;
           color: white;
           cursor: pointer;
     }

     #hotbaritems > * {
   max-height: 100%;
   max-width: 100%;
   overflow: hidden;
}

     #hotbarlogs {
           margin-top: -10vh;
           margin-left: 47vw;
           z-index: 1000001;
           display: flex;
           justify-content:flex-end;
           align-items: center;
           width: 50vw;
           height: 10vh;
           font-size: 1vw;
           font-family: 'Orbitron', sans-serif;
           font-weight: bolder;
           color: white;
     }

     #video {
         z-index:-1;
           grid-column: 1/21;
           grid-row: 1/16;
           margin-top:-50vh;
           pointer-events: none;
         
     }

       .gradient-box {
           z-index:10;
           grid-column:1/21;
           grid-row:3/14;
           width: 100%;
           height: 100%; 
           background: linear-gradient(to top, black, transparent);
           pointer-events: none; 
       }


       .lowerblank {
           z-index: -100;
           grid-column: 1/21;
           grid-row: 14/21;
           background-color:black;
       }

       .climb {
           color: white;
           font-size: 3vw;
           grid-column: 1/21;
           grid-row: 4/7;
           display: flex;
           justify-content: center;
           align-items: center;
           z-index: 998;
           font-family: 'Orbitron', sans-serif;
           font-weight: bolder;
       }

       .climb2 {
           color: white;
           font-size: 1.5vw;
           grid-column: 6/16;
           grid-row: 6/9;
           display: flex;
           justify-content: center;
           align-items: center;
           z-index: 1000;
           font-family: 'Orbitron', sans-serif;
           font-weight: 300;
           text-align: center;
       }

       .signupbut {
           grid-column: 1/21;
           grid-row: 9/11;
           background-color:rgb(47, 144, 255);
           color:white;
           border-radius: 1vw;
           width:8vw;
           height: 6vh;
           z-index: 10001;
           display: flex;
           justify-self: center;
           align-self: center;
