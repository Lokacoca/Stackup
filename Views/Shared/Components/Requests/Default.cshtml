<head>
    <style>

        .btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
        box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
        }

        .Board {
        display: flex;
        flex-wrap: nowrap;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        padding: 20px;
        border: solid 0.13em #4C4E52;
        overflow-y: scroll;
        overflow-x: hidden;
        z-index: 10000;
        padding-top: -10em;
        height: 100%;
        width: 100%;
        overflow: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        background-color: #16171d;
        border-radius: 1em;
        z-index:10000;
        }

        .Board::-webkit-scrollbar {
        display: none;
        }

        .request {
        background-color: #272833;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        min-height: 108px;
        padding: 10px;
        transition: transform 0.3s, box-shadow 0.3s;
        width: 100%;
        user-select: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
            z-index: 10000;
        }

        .accept {
        background-color: rgb(62, 128, 62);
        text-align: center;
        color: white;
        padding: 6px 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        user-select: none;
        cursor: pointer;
        font-size: 12px;
            z-index: 10000000010;
        }

        .decline {
        background-color: rgb(187, 70, 66);
        text-align: center;
        color: white;
        padding: 6px 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        user-select: none;
        cursor: pointer;
        font-size: 12px;
        z-index: 10000000010;
        }

        .flexing {
        grid-column: 1/5;
        grid-row: 3;
        display: flex;
        justify-content: space-evenly;
        }

        .Name {
        color: white;
        font-size: 1.2em;
        user-select: none;
        grid-row: 1/3;
        grid-column: 1/5;
        display: flex;
        justify-content: center;
        margin-top: 4px;
        }


        .Profile12 {
        background-color: rgb(33, 99, 175);
        text-align: center;
        color: white;
        padding: 6px 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        user-select: none;
        cursor: pointer;
        font-size: 12px;
            z-index: 10000000010;
        }

        .Profile12:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: rgb(47, 144, 255);
        transition: transform 0.3s ease, background-color 0.3s ease;
        }


        .accept:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: rgb(45, 161, 45);
        transition: transform 0.3s ease, background-color 0.3s ease;
        }

        .decline:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: rgb(207, 55, 50);
        transition: transform 0.3s ease, background-color 0.3s ease;
        }
        .boop{
            display:flex;
            justify-self:center;
            text-align: center;
        }
    </style>
</head>

@model System.Data.DataTable


<div class="Board">

    @if(Model.Rows.Count != 0)
    {
        @for (int i = 0; i < Model.Rows.Count; i++)
        {
            <div class="request">
                <h1 class="Name">@Model.Rows[i]["Name"]</h1>
                <div class="flexing">
                    <a class="accept" href="@Url.Action("CheckRequest", "Home", new{uid = Model.Rows[i]["UID"], tid = Model.Rows[i]["TID"], rid = Model.Rows[i]["RID"] })">Accept</a>
                    <a class="decline" href="@Url.Action("DeclineRequest", "Home", new{tid = Model.Rows[i]["TID"], rid =  Model.Rows[i]["RID"]})">Decline</a>
                    <a class="Profile12" href="@Url.Action("ViewTeam", "Home", new{TID = Model.Rows[i]["TID"]})">View</a>
                </div>
            </div>
        }

    }
    else
    {
        <p class="boop"> Invitations from teams will arrive here!</p>
    }






</div> 