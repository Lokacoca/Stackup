<head>
    <style>

        .btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
            box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
        }

        .Board {
            display: flex;
            flex-wrap: nowrap;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            padding: 20px;
            border: solid 0.13em #4C4E52;
            overflow-y: scroll;
            overflow-x: hidden;
            z-index: 10000;
            padding-top: -10em;
            height: 40vh;
            width: 14vw;
            overflow: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

            .Board::-webkit-scrollbar {
                display: none;
            }

        .request {
            background-color: #272833;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            min-height: 108px;
        padding: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
            width: 100%;
            user-select: none;
            display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
        }

        .accept {
            background-color: rgb(62, 128, 62);
            text-align: center;
            color: white;
            padding: 6px 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            cursor: pointer;
            font-size: 12px;
        }

        .decline {
            background-color: rgb(187, 70, 66);
            text-align: center;
            color: white;
            padding: 6px 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            cursor: pointer;
            font-size: 12px;
        }

        .flexing {
            grid-column: 1/5;
            grid-row: 3;
            display: flex;
            justify-content: space-evenly;
        }

        .Name {
            color: white;
            font-size: 1.2em;
            user-select: none;
            grid-row: 1/3;
            grid-column: 1/5;
            display: flex;
            justify-content: center;
           margin-top: 4px;
        }


        .Profile12 {
            background-color: rgb(33, 99, 175);
            text-align: center;
            color: white;
            padding: 6px 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            cursor: pointer;
            font-size: 12px;
        }

            .Profile12:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
                background-color: rgb(47, 144, 255);
                transition: transform 0.3s ease, background-color 0.3s ease;
            }


        .accept:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            background-color: rgb(45, 161, 45);
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

        .decline:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            background-color: rgb(207, 55, 50);
            transition: transform 0.3s ease, background-color 0.3s ease;
        }
    </style>
</head>

@model System.Data.DataTable

 <div class="Board"> 

    @for (int i = 0; i < Model.Rows.Count; i++)
    {
        <div class="request">
            <h1 class="Name">@Model.Rows[i]["Username"]</h1>
            <div class="flexing">
            <a class="accept" href="@Url.Action("AcceptJoin", "Home", new{UID = Model.Rows[i]["UID"], Tid = Context.Session.GetInt32("TID"), JID = Model.Rows[i]["JID"] })">Accept</a>
            <a class="decline" href="@Url.Action("DeclineJoin", "Home", new{tid = Model.Rows[i]["TID"], jid =  Model.Rows[i]["JID"]})">Decline</a>
                <a class="Profile12" href="@Url.Action("Profile", "Home", new{UID = Model.Rows[i]["UID"]})">Profile</a>
            </div>
        </div>
    }






</div> 