<head>
    <style>
        #lobby{
        color: white;
        font-weight: Bolder;
        font-family: 'Orbitron', sans-serif;
        background-color: #16171d;
        border-radius: 0.5em;
        padding-left: 0.2vw;
        margin-left: 2.5%;
        margin-top: 2vh;
        display: grid;
        grid-template-columns: repeat(20,2.25vw);
        grid-template-rows: repeat(1, 1fr);
        width: 95%;
        height: 4vw;
        }

        #lobby:hover{
        background-color: #242530;
        transition: background-color 0.2s ease;
        }

        .left {
            grid-row: 1;
            grid-column: 1/3;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .left2 {
            grid-row: 1;
            grid-column: 3/8;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
        }

        .mid {
            grid-row: 1;
            grid-column: 8/12;
        }

        .right {
            grid-row: 1;
            grid-column: 18/20;
            display: flex;
            justify-content: flex-start;
            align-items: center;
        }

        .right2 {
        grid-row: 1;
        grid-column: 12/18;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
        }

        .name1{
        color: white;
        font-weight: Bolder;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.8vw;
        margin-left: 1vw;
        }

        .name2 {
        color: white;
        font-weight: Bolder;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.8vw;
        margin-right: 1vw;
        }

        .vs{
        color: white;
        font-weight: Bolder;
        font-family: 'Orbitron', sans-serif;
        font-size: 1.6vw;
        margin-left: 3.5vw;
        margin-top: 1vh;
        }

        .view {

        background-color: rgb(47, 144, 255);
        color: white;
        border-radius: 1vw;
            width: 2vw;
            height: 2vh;
        z-index: 10001;
        display: flex;
        justify-self: center;
        align-self: center;
        justify-content: center;
        align-items: center;
        font-family: 'Orbitron', sans-serif;
        font-weight: 800;
        font-size: 0.5vw;
        transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
        text-decoration:none;
            margin-left: 0.25vw;

        }

        .view:hover {
        background-color: rgb(25, 71, 124);
        color: black;
        font-weight: bolder;
        transform: scale(1.05);
        }

        .view2 {
            background-color: rgb(47, 144, 255);
            color: white;
            border-radius: 1vw;
            width: 2vw;
            height: 2vh;
            z-index: 10001;
            display: flex;
            justify-self: center;
            align-self: center;
            justify-content: center;
            align-items: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            font-size: 0.5vw;
            transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
            text-decoration: none;
        }

            .view2:hover {
                background-color: rgb(25, 71, 124);
                color: black;
                font-weight: bolder;
                transform: scale(1.05);
            }

        .join {
            background-color: rgb(75, 196, 45);
        color: white;
        border-radius: 1vw;
            width: 2vw;
            height: 2vh;
        z-index: 10001;
        display: flex;
        justify-self: center;
        align-self: center;
        justify-content: center;
        align-items: center;
        font-family: 'Orbitron', sans-serif;
        font-weight: 800;
        font-size: 0.5vw;
        transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
        text-decoration: none;
            margin-right: 0.25vw;
        }

        .join:hover {
        background-color: rgb(42, 124, 25);
        color: black;
        font-weight: bolder;
        transform: scale(1.05);
        }

        .pic1{
            height: 3.5vw;
            width: 3.5vw;
        background-color: #282935;
        border-radius: 50%;
        }

        .pic2 {
            height: 3.5vw;
            width: 3.5vw;
        background-color: #282935;
        border-radius: 50%;
        }

        #buttons {
            margin-left: 1vw;
            margin-top: 0.6vh;
        display:flex;
        justify-content: center;
        }


    </style>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
</head>
<div class="Results" id="searchResults">

    <div class="flow">

        @model System.Data.DataTable


        @for (int i = 0; i < Model.Rows.Count; i++)
        {
            <div id="lobby">
                <div class="left">
                    <img class="pic1" src="~/Bilder/@Model.Rows[i]["Picture"]" width="40" height="40" />
                </div>
                <div class="left2">
                    <p class="name1">@Model.Rows[i]["Name"]</p>
                </div>


                <div class="mid">
                    <p class="vs">VS</p>
                    <div id="buttons">
                        @if (Convert.ToInt32(ViewData["Check"]) == 1 && Convert.ToInt32(ViewData["Check2"]) != 1 && Convert.ToInt32(ViewData["Check3"]) != 1)
                        {
                            <a class="join" href="@Url.Action("JoinLobby","Home", new{lid = Model.Rows[i]["LID"] , members = ViewData["error"] })">Join</a>
                            <a class="view" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[i]["LID"], Active = Model.Rows[i]["Active"]})">View</a>

                        }
                        else
                        {
                            <a class="view2" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[i]["LID"], Active = Model.Rows[i]["Active"]})">View</a>

                        }
                    </div>
                </div>

                                <div class="right2">
                    <p class="name2">Searching...</p>
                </div>

                <div class="right">
                    <img class="pic2" src="~/Bilder/r0.png" width="40" height="40" />
                </div>


            </div>
        }
    </div>

</div>


