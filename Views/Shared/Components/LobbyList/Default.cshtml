<head>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
</head>
<div class="Results" id="searchResults">

    <div class="flow">

        @model System.Data.DataTable


        @for (int i = 0; i < Model.Rows.Count; i++)
        {
            <div id="lobby">
                <div class="left">
                    <img class="pic1" src="~/Bilder/@Model.Rows[i]["Picture"]" width="40" height="40" />
                </div>
                <div class="left2">
                    <p class="name1">@Model.Rows[i]["Name"]</p>
                </div>


                <div class="mid">
                    <p class="vs">VS</p>
                    <div id="buttons">
                        @if (Convert.ToInt32(ViewData["Check"]) == 1 && Convert.ToInt32(ViewData["Check2"]) != 1 && Convert.ToInt32(ViewData["Check3"]) != 1)
                        {
                            <a class="join" href="@Url.Action("JoinLobby","Home", new{lid = Model.Rows[i]["LID"] , members = ViewData["error"] })">Join</a>
                            <a class="view" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[i]["LID"], Active = Model.Rows[i]["Active"]})">View</a>

                        }
                        else
                        {
                            <a class="view2" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[i]["LID"], Active = Model.Rows[i]["Active"]})">View</a>

                        }
                    </div>
                </div>

                                <div class="right2">
                    <p class="name2">Searching...</p>
                </div>

                <div class="right">
                    <img class="pic2" src="~/Bilder/r0.png" width="40" height="40" />
                </div>


            </div>
        }
    </div>

</div>


