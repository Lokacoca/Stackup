@model System.Data.DataTable

<div class="Board">

    @for (int i = 0; i < Model.Rows.Count; i++)
    {
        <img src="~/Bilder/@Model.Rows[i]["Picture"]" width="75" height="75">

        <a href="@Url.Action("ViewTeam", "Home", new{TID = Model.Rows[i]["TID"]})"> @Model.Rows[i]["Name"]</a>




    }


</div>