
<head>
    </head>
 @model System.Data.DataTable

@if (Model.Rows.Count == 0 )
{
    if (Convert.ToInt32(ViewData["BEN"]) != 1)
    {
        <p class="failed">This User Is Currently Not Participating In A Lobby</p>

    }
}

else if( Convert.ToInt32(ViewData["BEN"]) == 1)
{
    if (Convert.ToInt32(ViewData["TWO"]) == 1){
        <a class="hotbarbuttons Lobby" href="@Url.Action("Lobby", "Home", new{LID  = Model.Rows[0]["LID"], Active = "YES"})">My Lobby</a>

    }else{
        <a class="hotbarbuttons Lobby" href="@Url.Action("Lobby", "Home", new{LID  = Model.Rows[0]["LID"], Active = "NO"})">My Lobby</a>

    }
}else
{

        @if (Convert.ToInt32(ViewData["TWO"]) == 1)
        {
<div class="Results" id="searchResults">

    <div class="flow">
            <div id="lobby1">
                <div class="left1">
                    <img class="pic11" src="~/Bilder/@Model.Rows[0]["Logo1"]" width="40" height="40" />
                </div>
                <div class="left21">
                    <p class="name11">@Model.Rows[0]["Name1"]</p>
                </div>


                <div class="mid1">
                    <p class="vs1">VS</p>
                    <div id="buttons1">
                            <a class="view21" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[0]["LID"], Active = "YES"})">View</a>

                        
                    </div>
                </div>

                <div class="right21">
                    <p class="name21">@Model.Rows[0]["Name2"]</p>
                </div>

                <div class="right1">
                    <img class="pic21" src="~/Bilder/@Model.Rows[0]["Logo2"] " width="40" height="40" />
                </div>


            </div>
    </div>

</div>

        }
        else
        {

<div class="Results" id="searchResults">

    <div class="flow">
            <div id="lobby1">
                <div class="left1">
                    <img class="pic11" src="~/Bilder/@Model.Rows[0]["Picture"]" width="40" height="40" />
                </div>
                <div class="left21">
                    <p class="name11">@Model.Rows[0]["Name"]</p>
                </div>


                <div class="mid1">
                    <p class="vs1">VS</p>
                    <div id="buttons1">
                  
                            <a class="view21" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[0]["LID"], Active = "NO"})">View</a>

                        
                    </div>
                </div>

                                <div class="right21">
                    <p class="name21">Searching...</p>
                </div>

                <div class="right1">
                    <img class="pic21" src="~/Bilder/r0.png" width="40" height="40" />
                </div>


            </div>
        
    </div>

</div>
            
        }

   



    
}
