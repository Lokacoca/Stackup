
<head>
    <style>
        #lobby1 {
            color: white;
            font-weight: Bolder;
            font-family: 'Orbitron', sans-serif;
            background-color: #16171d;
            border-radius: 0.5em;
            padding-left: 0.2vw;
            margin-left: 2.5%;
            margin-top: 2vh;
            display: grid;
            grid-template-columns: repeat(4,2.25vw);
            grid-template-rows: repeat(1, 1fr);
            width: 95%;
            height: 4vw;
        }

            #lobby:hover {
                background-color: #242530;
                transition: background-color 0.2s ease;
            }

        .left1 {
            grid-row: 1;
            grid-column: 1/3;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .left21 {
            grid-row: 1;
            grid-column: 3/8;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
        }

        .mid1 {
            grid-row: 1;
            grid-column: 7/11;
        }

        .right1 {
            grid-row: 1;
            grid-column: 18/20;
            display: flex;
            justify-content: flex-start;
            align-items: center;
        }

        .right21 {
            grid-row: 1;
            grid-column: 12/18;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;
        }

        .name11 {
            color: white;
            font-weight: Bolder;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8vw;
            margin-left: 1vw;
        }

        .name21 {
            color: white;
            font-weight: Bolder;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8vw;
            margin-right: 1vw;
        }

        .vs1 {
            color: white;
            font-weight: Bolder;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6vw;
            margin-left: 3.15vw;
            margin-top: 1vh;
        }

        .view1 {
            background-color: rgb(47, 144, 255);
            color: white;
            border-radius: 1vw;
            width: 2vw;
            height: 2vh;
            z-index: 10001;
            display: flex;
            justify-self: center;
            align-self: center;
            justify-content: center;
            align-items: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            font-size: 0.5vw;
            transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
            text-decoration: none;
            margin-left: 0.25vw;
        }

            .view1:hover {
                background-color: rgb(25, 71, 124);
                color: black;
                font-weight: bolder;
                transform: scale(1.05);
            }

        .view21 {
            background-color: rgb(47, 144, 255);
            color: white;
            border-radius: 1vw;
            width: 2vw;
            height: 2vh;
            z-index: 10001;
            display: flex;
            justify-self: center;
            align-self: center;
            justify-content: center;
            align-items: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            font-size: 0.5vw;
            transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
            text-decoration: none;

        }

            .view21:hover {
                background-color: rgb(25, 71, 124);
                color: black;
                font-weight: bolder;
                transform: scale(1.05);
            }

        .join1 {
            background-color: rgb(75, 196, 45);
            color: white;
            border-radius: 1vw;
            width: 2vw;
            height: 2vh;
            z-index: 10001;
            display: flex;
            justify-self: center;
            align-self: center;
            justify-content: center;
            align-items: center;
            font-family: 'Orbitron', sans-serif;
            font-weight: 800;
            font-size: 0.5vw;
            transition: transform 0.2s ease, background-color 0.2s ease, font-weight 0.2s ease;
            text-decoration: none;
            margin-right: 0.25vw;
        }

            .join1:hover {
                background-color: rgb(42, 124, 25);
                color: black;
                font-weight: bolder;
                transform: scale(1.05);
            }

        .pic11 {
            height: 3.5vw;
            width: 3.5vw;
            background-color: #282935;
            border-radius: 50%;
        }

        .pic21 {
            height: 3.5vw;
            width: 3.5vw;
            background-color: #282935;
            border-radius: 50%;
        }

        #buttons1 {
            margin-left: 2.3vw;
            margin-top: 0.6vh;
            display: flex;
            justify-content: center;
        }
        .failed{
            justify-self:center;
        }
    </style>
    </head>
 @model System.Data.DataTable

@if (Model.Rows.Count == 0 )
{
    if (Convert.ToInt32(ViewData["BEN"]) != 1)
    {
        <p class="failed">This User Is Currently Not Participating In A Lobby</p>

    }
}

else if( Convert.ToInt32(ViewData["BEN"]) == 1)
{
    if (Convert.ToInt32(ViewData["TWO"]) == 1){
        <a class="hotbarbuttons Lobby" href="@Url.Action("Lobby", "Home", new{LID  = Model.Rows[0]["LID"], Active = "YES"})">My Lobby</a>

    }else{
        <a class="hotbarbuttons Lobby" href="@Url.Action("Lobby", "Home", new{LID  = Model.Rows[0]["LID"], Active = "NO"})">My Lobby</a>

    }
}else
{

        @if (Convert.ToInt32(ViewData["TWO"]) == 1)
        {
<div class="Results" id="searchResults">

    <div class="flow">
            <div id="lobby1">
                <div class="left1">
                    <img class="pic11" src="~/Bilder/@Model.Rows[0]["Logo1"]" width="40" height="40" />
                </div>
                <div class="left21">
                    <p class="name11">@Model.Rows[0]["Name1"]</p>
                </div>


                <div class="mid1">
                    <p class="vs1">VS</p>
                    <div id="buttons1">
                            <a class="view21" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[0]["LID"], Active = "YES"})">View</a>

                        
                    </div>
                </div>

                <div class="right21">
                    <p class="name21">@Model.Rows[0]["Name2"]</p>
                </div>

                <div class="right1">
                    <img class="pic21" src="~/Bilder/@Model.Rows[0]["Logo2"] " width="40" height="40" />
                </div>


            </div>
    </div>

</div>

        }
        else
        {

<div class="Results" id="searchResults">

    <div class="flow">
            <div id="lobby1">
                <div class="left1">
                    <img class="pic11" src="~/Bilder/@Model.Rows[0]["Picture"]" width="40" height="40" />
                </div>
                <div class="left21">
                    <p class="name11">@Model.Rows[0]["Name"]</p>
                </div>


                <div class="mid1">
                    <p class="vs1">VS</p>
                    <div id="buttons1">
                  
                            <a class="view21" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[0]["LID"], Active = "NO"})">View</a>

                        
                    </div>
                </div>

                                <div class="right21">
                    <p class="name21">Searching...</p>
                </div>

                <div class="right1">
                    <img class="pic21" src="~/Bilder/r0.png" width="40" height="40" />
                </div>


            </div>
        
    </div>

</div>
            
        }

   



    
}
