<head>

    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
</head>

    <div class="flow">

        @model System.Data.DataTable

<div class="Results" id="searchResults">

        @for (int i = 0; i < Model.Rows.Count; i++)
        {
            <div id="lobby">
                <div class="left">
                    <img class="pic1" src="~/Bilder/@Model.Rows[i]["Logo1"]" width="40" height="40" />
                </div>
                <div class="left2">
                    <p class="name1">@Model.Rows[i]["Name1"]</p>
                </div>


                <div class="mid">
                    <p class="vs">VS</p>
                    <div id="buttons">
                            <a class="view2" href="@Url.Action("Lobby", "Home", new{ LID = Model.Rows[i]["LID"], Active = Model.Rows[i]["Active"]})">View</a>

                        
                    </div>
                </div>

                <div class="right2">
                    <p class="name2">@Model.Rows[i]["Name2"]</p>
                </div>

                <div class="right">
                    <img class="pic2" src="~/Bilder/@Model.Rows[i]["Logo2"] " width="40" height="40" />
                </div>


            </div>
        }
    </div>

</div>


