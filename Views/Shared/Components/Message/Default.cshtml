<head>
    <style>
        /* Chat bubbles, shared by team chat and lobby chat.
           Class names are prefixed with "cm-" so page styles (e.g. .pic1 in stackup.css) can't leak in. */
        .chatflow {
        height: 35vh;
        padding: 10px 4px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        }

        .chatflow::-webkit-scrollbar { display: none; }

        .cm-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        max-width: 85%;
        align-self: flex-start;
        }

        .cm-row.cm-mine {
        flex-direction: row-reverse;
        align-self: flex-end;
        }

        .cm-pic {
        flex: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        }

        .cm-body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
        }

        .cm-mine .cm-body { align-items: flex-end; }

        .cm-name {
        margin: 0;
        padding: 0 6px;
        color: #c9cbd6;
        font-family: 'Orbitron', sans-serif;
        font-size: 10px;
        font-weight: bold;
        }

        .cm-tag {
        color: grey;
        font-weight: 100;
        opacity: 0.7;
        }

        .cm-bubble {
        margin: 0;
        padding: 8px 12px;
        color: white;
        font-family: 'Orbitron', sans-serif;
        font-size: 12px;
        font-weight: 300;
        line-height: 1.4;
        background-color: #2a2c38;
        border-radius: 14px 14px 14px 4px;
        overflow-wrap: anywhere;
        white-space: normal;
        }

        .cm-mine .cm-bubble {
        background-color: #1e4c81;
        border-radius: 14px 14px 4px 14px;
        }

        .REP { display: none; }
    </style>
</head>

<div class="flow chatflow">
    @* Own messages on the right, everyone else on the left. *@
    @for (int i = 0; i < Model.Rows.Count; i++)
    {
        bool mine = Convert.ToInt32(Model.Rows[i]["UID"]) == Context.Session.GetInt32("UID");
        <div class="cm-row @(mine ? "cm-mine" : "")">
            <img src="~/Bilder/@Model.Rows[i]["Picture"]" class="cm-pic" alt="">
            <div class="cm-body">
                <p class="cm-name">@Model.Rows[i]["UserName"] <span class="cm-tag">@Model.Rows[i]["tagline"]</span></p>
                <p class="cm-bubble">@Model.Rows[i]["Content"]</p>
            </div>
        </div>
    }

    <p class="REP">@ViewData["REP"]</p>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.chatflow').forEach(f => f.scrollTop = f.scrollHeight);
    });
</script>
