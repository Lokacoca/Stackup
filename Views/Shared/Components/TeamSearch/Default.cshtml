<head>
    <style>
        .behind, .behind1 {
        width: 95%;
        min-height: 80px;
        margin: 16px auto 0;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        background-color: #16171d;
        border-radius: 0.5em;
        color: white;
        font-weight: bolder;
        font-family: 'Orbitron', sans-serif;
        transition: background-color 0.2s ease;
        }

        .behind:hover, .behind1:hover {
        background-color: #242530;
        }

        .content, .content1 {
        flex: 1;
        min-width: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        }

        .content > p, .content1 > p {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        }

        .content > p:first-of-type {
        flex: 1;
        }

        .flow, .flow1 {
        height: 100%;
        overflow-y: auto;
        scrollbar-color: #242530 #1c1d25;
        scrollbar-width: thin;
        }

        .Profile12, .Profile123, .Profile124 {
        flex-shrink: 0;
        padding: 6px 12px;
        background-color: rgb(33, 99, 175);
        color: white;
        font-size: 12px;
        user-select: none;
        cursor: pointer;
        transition: transform 0.3s ease, background-color 0.3s ease;
        }

        .Profile124 { background-color: green; }

        .Profile12:hover, .Profile123:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: rgb(47, 144, 255);
        }

        .Profile124:hover {
        transform: translateY(-3px);
        background-color: lime;
        }

        #tag1, #tag12 {
        color: grey;
        font-weight: 100;
        font-size: 13px;
        opacity: 0.7;
        }

        #blue, #blue12 {
        color: cornflowerblue;
        }

        #pic1212 {
        flex-shrink: 0;
        background-color: #242530;
        border-radius: 50%;
        outline: solid #242530 5px;
        }
    </style>
</head>
<div class="Results1" id="searchResults1">

    <div class="flow1">

@model System.Data.DataTable


        @if (Convert.ToString(ViewData["boom"]) != "yes")
        {
            @for (int i = 0; i < Model.Rows.Count; i++)
            {
                <div class="behind1">
                    <div class="content1">
                        <p>Team: <span id="blue12">@Model.Rows[i]["Name"]</span></p>

                        <p>Leader: <span id="blue12">@Model.Rows[i]["UserName"]</span></p>

                        <vc:team-count tid="@Convert.ToInt32(Model.Rows[i]["TID"])"></vc:team-count>

                    <a class="Profile123" href="@Url.Action("ViewTeam", "Home", new{TID = Model.Rows[i]["TID"]})">View Team</a>
                        </div>
                </div>
            }
        }
</div>

                </div>


<p class="play1"><span id="blue12">@ViewData["Count"]</span>Teams found</p>